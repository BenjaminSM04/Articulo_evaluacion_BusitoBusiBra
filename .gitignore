# ---- Datos: no versionar imagenes medicas ni datasets pesados ----
data/raw/
data/processed/
*.png
*.jpg
*.jpeg
*.bmp
*.dcm

# Excepciones para figuras/documentos incluidos deliberadamente en docs.
!docs/**/*.png
!docs/**/*.jpg
!docs/**/*.jpeg

# ---- Resultados y artefactos generados ----
results/
runs/
*.pt
*.pth
*.ckpt
*.docx

# ---- Articulo cientifico ----
# El manuscrito se adjuntara como enlace externo; no se versionan borradores ni LaTeX.
articulo/
Latex Doc/

# Implementaciones archivadas o notas internas que no forman parte del paquete publico.
legacy/

# Auxiliares y salidas de compilacion de LaTeX, por si se compila fuera de "Latex Doc/".
*.aux
*.bbl
*.bcf
*.blg
*.fdb_latexmk
*.fls
*.lof
*.log
*.lot
*.out
*.run.xml
*.synctex.gz
*.toc
*.pdf
!docs/**/*.pdf

